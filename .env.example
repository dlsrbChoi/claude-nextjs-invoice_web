# Notion API 키 (https://www.notion.so/my-integrations 에서 생성)
NOTION_API_KEY=your_notion_api_key_here

# Notion 데이터베이스 ID (관리자 목록 조회에 사용)
# 데이터베이스 URL: https://www.notion.so/{databaseId}?v={viewId}
# 또는 데이터베이스 페이지에서 'Share' → 'Copy link' 후 ID 추출
NOTION_DATABASE_ID=your_notion_database_id_here

# 애플리케이션의 배포된 절대 URL (견적서 공유 링크 생성에 사용)
# 예: https://invoice.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
