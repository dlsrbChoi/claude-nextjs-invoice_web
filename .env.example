# Notion API 연동
# https://www.notion.so/my-integrations 에서 Integration 생성 후 토큰 복사
NOTION_API_KEY=your_notion_api_key_here

# Notion 데이터베이스 ID (선택사항)
# 특정 데이터베이스에서만 견적서를 조회하려는 경우 설정
# NOTION_DATABASE_ID=your_database_id_here

# 애플리케이션 설정
# 배포된 애플리케이션의 URL (프로덕션 환경)
# NEXT_PUBLIC_APP_URL=https://your-domain.com
